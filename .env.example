# Copy to .env (same folder) and fill in.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: thinking level for Gemini 3 models (default: low, for fast streaming).
# Leave it empty when using a Gemini 2.5 model, which rejects this setting.
# GEMINI_THINKING_LEVEL=low

# Optional: email customers their ticket number through Brevo (free account at https://www.brevo.com).
# MAIL_FROM must be a sender address you verified in Brevo (Settings → Senders).
# Leave either empty and the email is only written to the backend log.
# BREVO_API_KEY=
# MAIL_FROM=
